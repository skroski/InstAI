# ==========================================
# 1. AMBIENTE DA APLICAÇÃO & CODEMIX CONFIG
# ==========================================
NODE_ENV=development
APP_NAME="Codemix InstaAI Hub"
# Origem(ns) do front liberadas no CORS das Edge Functions, separadas por vírgula
APP_URL=http://localhost:4200
API_BASE_URL=http://localhost:54321/functions/v1
DEFAULT_THEME=codemix-dark

# ==========================================
# 2. SUPABASE (DATABASE, AUTH & VAULT)
# ==========================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ENCRYPTION_KEY=chave-secreta-32-bytes-para-tokens-meta

# ==========================================
# 3. META FOR DEVELOPERS / INSTAGRAM & MARKETING API
# ==========================================
META_APP_ID=123456789012345
META_APP_SECRET=abcdef1234567890abcdef1234567890
META_GRAPH_API_VERSION=v22.0
META_OAUTH_REDIRECT_URI=http://localhost:4200/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=codemix_insta_webhook_secret_2026

# Meta Marketing API (Lookalikes, Listas de Contato e Campanhas)
# Permissões do app no Meta Developers: ads_management, ads_read, business_management
META_AD_ACCOUNT_ID=act_1029384756
META_SYSTEM_USER_TOKEN=EAAG...long_lived_token_com_permissao_ads

# ==========================================
# 4. MOTORES DE IA (CLAUDE, CODEX/OPENAI, GEMINI)
# ==========================================
# Anthropic (Claude) - Foco em Copywriting, Legendas e Estratégia
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_DEFAULT_MODEL=claude-3-7-sonnet-latest

# OpenAI (Codex / GPT) - Foco em Estruturação JSON, Automação e Código/Payloads
OPENAI_API_KEY=sk-proj-...
