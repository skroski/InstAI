OPENAI_REASONING_MODEL=o3-mini

# Google (Gemini) - Foco em Contexto Longo, Engenharia de Prompts Visuais e Inbox Rápido
GEMINI_API_KEY=AIzaSy...
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Roteamento Padrão de IA (claude | codex | gemini | auto)
DEFAULT_AI_ENGINE=auto

